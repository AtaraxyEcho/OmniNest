# English counterpart of .env.example; keep both templates in sync when changing either.
# Backend run profile and process role. dev relies on local defaults; prod reuses the same variable names to override deployment addresses.
OMNINEST_PROFILE=dev
OMNINEST_ROLE=api
# Embeds the worker inside the API process for a single 4C4G instance; keep false when the three roles are split.
OMNINEST_RUNTIME_EMBEDDED_WORKER_ENABLED=false
OMNINEST_SERVER_PORT=8080
# Application log file (relative to the backend working directory); do not write it into the module root.
OMNINEST_LOG_PATH=logs/omninest.log

# Media derive/transcode temp root; keep off PG/MinIO data volumes.
OMNINEST_PROCESSING_ROOT=../.omninest/processing

# PostgreSQL
OMNINEST_DB_URL=jdbc:postgresql://localhost:5432/omninest
OMNINEST_DB_USER=omninest
OMNINEST_DB_PASSWORD=omninest

# Redis and RabbitMQ
OMNINEST_REDIS_HOST=localhost
OMNINEST_REDIS_PASSWORD=
OMNINEST_RABBITMQ_HOST=localhost
OMNINEST_RABBITMQ_USER=omninest
OMNINEST_RABBITMQ_PASSWORD=omninest

# Identity, security and first-run setup
# HS256 JWT signing secret, at least 32 bytes; it signs and verifies every login token and must be replaced in production.
OMNINEST_SECURITY_JWT_SECRET=change-me-omninest-local-jwt-secret-at-least-32-bytes
# Base64-encoded 32-byte AES-GCM key (KEK) that encrypts external integration credentials stored in the database;
# leaving it empty counts as unconfigured, and saving credentials that require encryption then fails with a config error.
# Generate one with: openssl rand -base64 32
OMNINEST_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
# Whether the first-run setup wizard endpoints stay open; set to false after installation to close them off.
OMNINEST_SETUP_ENABLED=true
# Source of truth for setup completion: true reads the persisted system_instance state, false falls back to whether a SUPER_ADMIN user exists.
OMNINEST_SETUP_PERSISTENT_STATE_ENABLED=true
# First-run setup token, at least 32 bytes. Creating the first super admin requires the same value in the X-Setup-Token request header, otherwise the request is rejected.
OMNINEST_SETUP_TOKEN=change-me-omninest-setup-token-at-least-32-bytes
# Whether the setup wizard requires the super admin to complete two-factor registration. Default false; public deployments may set true (the deploy/prod template carries the same key).
OMNINEST_SETUP_TWOFACTORREQUIRED=false
# Production-wide HTTPS switch: it drives Nginx/certbot TLS on the deployment side and the refresh cookie Secure attribute on the backend side.
# The dev-profile backend does not read this key; to verify cookie behavior locally use the variable below.
OMNINEST_HTTPS_ENABLED=false
# Whether the refresh token cookie carries the Secure attribute: when true the browser only sends the cookie over HTTPS,
# so plain-HTTP access can no longer stay signed in. Read by the dev profile only; prod controls it through OMNINEST_HTTPS_ENABLED.
OMNINEST_SECURITY_REFRESH_COOKIE_SECURE=false
# SameSite attribute of the refresh token cookie (STRICT/LAX/NONE). The default STRICT only sends the cookie on same-site
# requests; cross-origin deployments (frontend page and API on different origins) must switch to NONE, which forces the
# Secure attribute on the backend side and therefore only works over HTTPS.
OMNINEST_SECURITY_REFRESH_COOKIE_SAME_SITE=STRICT
# Whether self-service user registration (/api/v1/auth/register) is open. When false the endpoint returns REGISTRATION_DISABLED,
# and accounts can only be created by the setup-created super admin or by administrators in user management.
OMNINEST_SECURITY_REGISTRATION_ENABLED=false
# Trusted reverse proxies as a comma-separated IP/CIDR list. X-Forwarded-For / X-Real-IP headers are honored only when
# the direct TCP peer matches this list (used for login rate limiting). When empty the direct address is always used,
# so behind a reverse proxy every request resolves to the proxy address.
OMNINEST_SECURITY_TRUSTED_PROXIES=
# Browser origins allowed for CORS and WebSocket handshakes (comma separated); include the addresses the frontend is actually served from, a different port counts as a different origin.
OMNINEST_SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Base URL of the Flutter web frontend (e.g. https://omninest.example.com). The backend /setup endpoint redirects to
# the install wizard at {base}/#/setup; when empty it redirects to the same-origin /#/setup, which fits the layout where the backend serves OMNINEST_WEBAPP_DIR.
OMNINEST_SETUP_WEB_BASE_URL=

# MinIO managed content
# Server-side address used by the backend MinIO SDK.
OMNINEST_MINIO_ENDPOINT=http://localhost:9000
# Base address for presigned URLs handed to browsers/apps; must be reachable by clients (avoid localhost for mobile devices).
OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Address used for presigned URLs consumed by containers on the Docker network (FFmpeg video processing etc.); empty falls back to ENDPOINT.
OMNINEST_MINIO_DOCKER_ENDPOINT=http://omninest-minio:9000
OMNINEST_MINIO_ACCESS_KEY=minioadmin
OMNINEST_MINIO_SECRET_KEY=minioadmin

# Local read-only media mounts. The capability defaults to on, but enabling it alone does not scan, copy or import any media.
# An administrator still has to create a SYSTEM storage location and Movie / TV / Anime libraries in Media.
OMNINEST_LOCAL_MEDIA_ENABLED=true
# Trusted root the backend process can actually access (the security boundary, not a per-user directory).
# Must point to the same physical media root as OMNINEST_LOCAL_MEDIA_ROOT in deploy/dev/.env.
OMNINEST_LOCAL_MEDIA_ROOT=../.omninest/local-media
# Path of the same trusted root as seen by the FFmpeg media-processing process.
# Development FFmpeg currently runs through Docker, where the mount is /mnt/local-media.
OMNINEST_LOCAL_MEDIA_PROCESS_ROOT=/mnt/local-media

# Conditional services
# Must be false when the ClamAV container is not running, otherwise uploads are rejected because scanning is unavailable (fail-closed).
OMNINEST_CLAMAV_ENABLED=false
OMNINEST_CLAMAV_HOST=localhost
OMNINEST_CLAMAV_PORT=3310
# Rebuildable search index directories (relative to the backend working directory; each key appears once)
OMNINEST_SEARCH_INDEX_PATH=../.omninest/lucene-index
OMNINEST_SEARCH_PHOTO_INDEX_PATH=../.omninest/lucene-photo-index
# GeoNames offline reverse-geocoding dataset directory (relative to the backend working directory).
# When the files are complete and no dataset is published yet, startup triggers the import automatically;
# see the photo.geo.import.* config-center keys.
OMNINEST_GEO_IMPORT_DIR=../data/geonames
OMNINEST_RCLONE_ENDPOINT=http://localhost:5572
OMNINEST_RCLONE_RC_USER=admin
OMNINEST_RCLONE_RC_PASS=secret
OMNINEST_RCLONE_LOCAL_HOST_PATH=../.omninest/local-files
OMNINEST_RCLONE_IMPORT_HOST_PATH=../.omninest/rclone-imports
OMNINEST_RCLONE_IMPORT_CONTAINER_PATH=/mnt/imports
OMNINEST_ARIA2_RPC_URL=http://localhost:6800/jsonrpc
OMNINEST_ARIA2_RPC_SECRET=omninest
# Aria2 download root. Inside Docker this must be the container path (e.g. /downloads).
OMNINEST_ARIA2_DOWNLOAD_ROOT=../.omninest/aria2

# External service topology. Feature switches and credentials are managed in Admin integration settings.
OMNINEST_NETEASE_API_BASE_URL=http://localhost:3001
# Image analysis sidecar (currently focused on face detection, embeddings and clustering)
OMNINEST_PHOTO_AI_ENDPOINT=http://localhost:8090
OMNINEST_PHOTO_AI_TIMEOUT_SECONDS=30
OMNINEST_PHOTO_AI_MAX_IMAGE_BYTES=67108864
OMNINEST_PHOTO_AI_MAX_RESPONSE_BYTES=1048576
# AI sidecar authentication secret. Backend and sidecar must match; it must not stay empty in production.
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
# User-Agent used when calling MusicBrainz metadata APIs; their API policy asks for deployer contact information.
OMNINEST_MUSICBRAINZ_USER_AGENT=OmniNest/0.1.0 (contact@example.com)

# Reader and web static assets
# Dev single-process convenience: true lets the API process consume the comic parsing queue directly; prod defaults to false with a dedicated worker.
OMNINEST_READER_COMIC_CONSUME_IN_API=true
# Flutter web build output served by the backend (dev static resource path); copy the flutter build web output here to serve it.
OMNINEST_WEBAPP_DIR=./webapp

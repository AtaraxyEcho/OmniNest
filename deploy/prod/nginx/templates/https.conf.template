map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${OMNINEST_PUBLIC_HOST};

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${OMNINEST_HTTPS_REDIRECT_AUTHORITY}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${OMNINEST_PUBLIC_HOST};
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $omninest_backend backend-api:8080;

    ssl_certificate /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OmniNestTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS 由本层下发：后端 forward-headers-strategy 故意设为 none（转发头只由
    # TrustedProxyClientIpResolver 按可信代理边界解析），因此后端 request.isSecure()
    # 在反代之后恒为 false，SecurityHeaderFilter 不会输出该头。
    # add_header 在 location 级不继承 server 级，已自声明响应头的 location 必须各自补一行。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        return 200 'ok';
    }

    location /api/ {
        # 兜底请求体上限：后端 multipart 限 512MB，预留直传转码余量；
        # 仅作用于本 location，9000 端口的 MinIO 分片直传代理不受限
        client_max_body_size 2g;
        proxy_pass http://$omninest_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /ws {
        proxy_pass http://$omninest_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # 压缩与缓存：Flutter Web 产物文件名不带内容哈希，入口与 Service Worker
    # 必须每次校验，其余静态资源给 1 小时有界缓存避免发版后陈旧。
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml font/ttf font/otf;

    # SPA 主文档与静态回退：补齐后端 SecurityHeaderFilter 同款安全响应头
    #（该 Filter 只覆盖 /api/ 响应，nginx 直发的主文档不经过后端）。
    # add_header 在 location 级不继承 server 级，两处必须写全。
    location = ${OMNINEST_WEB_BASE_PATH}index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' http: https: ws: wss:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'";
        add_header X-Content-Type-Options "nosniff";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header Referrer-Policy "strict-origin-when-cross-origin";
        add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()" always;
        add_header X-Permitted-Cross-Domain-Policies "none" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location = ${OMNINEST_WEB_BASE_PATH}flutter_service_worker.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    # 引导脚本与版本清单决定客户端加载哪一份构建产物，缓存会让发版后继续跑旧版：
    # flutter_bootstrap.js 内嵌 service worker 版本号，version.json 是构建版本清单。
    location = ${OMNINEST_WEB_BASE_PATH}flutter_bootstrap.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location = ${OMNINEST_WEB_BASE_PATH}version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff";
        add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()" always;
        add_header X-Permitted-Cross-Domain-Policies "none" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # 不回退到 $uri/：构建产物里的 assets/canvaskit/css 等真实目录会命中目录索引，
        # autoindex 关闭时直接 403，而前端路由需要的是主文档。
        try_files $uri ${OMNINEST_WEB_BASE_PATH}index.html;
    }
}

server {
    listen 9000 ssl;
    http2 on;
    server_name ${OMNINEST_PUBLIC_HOST};
    client_max_body_size 0;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $omninest_minio minio:9000;

    ssl_certificate /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERTBOT_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OmniNestMinioTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location / {
        proxy_pass http://$omninest_minio;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

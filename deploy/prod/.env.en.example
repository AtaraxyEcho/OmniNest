# Chinese counterpart: .env.example; keep both templates (appendix included) in sync when changing either.
# Production Compose variable template. Copy to .env in this directory and replace public addresses
# and default credentials before deploying.
# Default profile: 4-core 4GB personal self-hosting with ClamAV and image analysis off.
# Day-to-day deployments only need the main body; override keys such as container memory,
# connection pools, PG tuning and certbot live in the "Advanced overrides" appendix at the
# end (all have defaults inside docker-compose.yml) - uncomment them when needed.

# Images and versioning.
OMNINEST_BACKEND_IMAGE=omninest/backend
OMNINEST_NGINX_IMAGE=omninest/nginx
# Self-built images share the OMNINEST_IMAGE_TAG version.
OMNINEST_IMAGE_TAG=0.1.0
# Deployment prefix of the Flutter web app inside the site; must be / or an absolute path like /omninest/.
# The prefix also applies to Canvaskit, the drift worker and endpoint addresses (API at <prefix>api/v1 and
# WebSocket at <prefix>ws), so the reverse proxy must strip it for those two locations; see README.
OMNINEST_WEB_BASE_HREF=/

# Public ports (remaining host-side management ports live in the appendix).
OMNINEST_PUBLIC_HTTP_PORT=80
OMNINEST_PUBLIC_HTTPS_PORT=443
# Public port of MinIO presigned URLs to clients; must match OMNINEST_MINIO_PUBLIC_ENDPOINT.
MINIO_API_PORT=9000

# Optional Compose profiles (comma separated).
# 4C4G defaults keep virus scanning and image analysis off.
# ClamAV: COMPOSE_PROFILES=clamav plus OMNINEST_CLAMAV_ENABLED=true
# Image analysis: COMPOSE_PROFILES=photo-ai
# COMPOSE_PROFILES=certbot,clamav,photo-ai
COMPOSE_PROFILES=

# Credentials. Never keep the sample weak values in production; replace each with an independent
# random value - Compose or the application refuses to start when one is missing.
POSTGRES_DB=omninest
POSTGRES_USER=omninest
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
RCLONE_RC_USER=admin
RCLONE_RC_PASS=CHANGE_ME_RCLONE_RC_PASS

# Public entry and HTTPS (certificate issuance/renewal keys live in the appendix certbot section).
# Public deployments must set true: with false the login password, JWTs and refresh cookies all
# travel in clear text. Only pure intranet/local deployments may keep false.
OMNINEST_HTTPS_ENABLED=false
OMNINEST_PUBLIC_HOST=localhost

# Maximum total bytes for one batch ZIP download (default 5GiB); tune to available egress bandwidth.
FILES_BATCH_DOWNLOAD_MAX_TOTAL_BYTES=5368709120

# Application security and first-run setup.
# HS256 JWT signing secret, at least 32 bytes; replace with a random value before deploying.
OMNINEST_SECURITY_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES
# Base64-encoded 32-byte AES-GCM key (KEK) that encrypts external integration credentials stored
# in the database; leaving it empty counts as unconfigured, and saving credentials that require
# encryption then fails with a config error. Generate one with: openssl rand -base64 32
OMNINEST_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
# Whether self-service user registration (/api/v1/auth/register) is open. When false, accounts can
# only be created by the super admin or administrators.
OMNINEST_SECURITY_REGISTRATION_ENABLED=false
# Trusted reverse proxies as a comma-separated IP/CIDR list. When left empty the Compose-internal
# Nginx address is trusted by default (OMNINEST_NGINX_INTERNAL_IP, appendix network section);
# adjust together when changing the subnet.
OMNINEST_SECURITY_TRUSTED_PROXIES=
# Browser origins allowed for CORS and WebSocket handshakes (comma separated); change to the
# addresses the frontend is actually served from.
OMNINEST_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
# SameSite attribute of the refresh token cookie (STRICT/LAX/NONE). The default STRICT fits the
# same-domain Nginx reverse-proxy layout; cross-origin deployments must switch to NONE, which
# forces the Secure attribute and therefore only works over HTTPS.
OMNINEST_SECURITY_REFRESH_COOKIE_SAME_SITE=STRICT
# Whether the first-run setup wizard endpoints stay open; set to false after installation.
OMNINEST_SETUP_ENABLED=true
# Source of truth for setup completion: true reads the persisted system_instance state, false
# falls back to whether a SUPER_ADMIN user exists.
OMNINEST_SETUP_PERSISTENT_STATE_ENABLED=true
# Whether the setup wizard forces two-factor registration for the super admin (false matches the
# backend default; switch to true when needed).
OMNINEST_SETUP_TWOFACTORREQUIRED=false
# First-run setup token, at least 32 bytes. Creating the first super admin requires the same value
# in the X-Setup-Token request header; empty or too short makes the setup endpoints reject every
# request, so fill it in before deploying.
OMNINEST_SETUP_TOKEN=
# Public base URL of the Flutter web frontend (the externally reachable site root, e.g.
# https://media.example.com). It drives the setup wizard redirect and the photo/file share-link
# base (delivered via /me/web-share-base-url); when empty share links degrade to the client's own
# address and break across devices, so production deployments must fill it in.
OMNINEST_SETUP_WEB_BASE_URL=

# Client-reachable addresses and local media.
# Public MinIO address handed to clients; must point at the Nginx public port (match MINIO_API_PORT).
OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Local read-only movie/TV mounts. Prefer a controlled absolute path on production servers.
OMNINEST_LOCAL_MEDIA_ENABLED=true
OMNINEST_LOCAL_MEDIA_ROOT=../.omninest/local-media
# GeoNames offline reverse-geocoding dataset directory (container path backed by the
# omninest-geonames volume). Drop the GeoNames dump into that volume (e.g. docker compose cp)
# and restart the backend to trigger the automatic import.
OMNINEST_GEO_IMPORT_DIR=/var/lib/omninest/geonames

# Conditional services.
# 4C4G defaults keep ClamAV off; enable it on public deployments with memory to spare
# (scan parameters and memory limits live in the appendix).
OMNINEST_CLAMAV_ENABLED=false
# Image-analysis sidecar authentication secret. Required even while photo-ai stays disabled:
# Compose enforces a non-empty value for this key.
OMNINEST_AI_SIDECAR_SECRET=CHANGE_ME_AI_SIDECAR_SECRET
# User-Agent used when calling MusicBrainz metadata APIs; their API policy asks for deployer
# contact information.
OMNINEST_MUSICBRAINZ_USER_AGENT=OmniNest/0.1.0 (contact@example.com)
# Retention for completed/failed photo batch ZIPs (default 7d). Increase it when the
# download window is longer than a week.
PHOTO_BATCH_RETENTION_ENABLED=true
PHOTO_BATCH_RETENTION_MAX_AGE=7d
PHOTO_BATCH_RETENTION_BATCH_SIZE=200

# =====================================================================
# Advanced overrides (usually not needed).
# Every key below has a default inside docker-compose.yml; uncomment and adjust as needed.
# Defaults follow the 4C4G profile - re-evaluate the memory budget yourself when changing them.
# =====================================================================

# --- Self-built Netease Cloud Music API image name ---
# OMNINEST_NETEASE_IMAGE=omninest-netease-music-api

# --- Host-side management ports and app log path (loopback-only or container-internal by default) ---
# OMNINEST_SERVER_PORT=8080
# MINIO_CONSOLE_PORT=9001
# RABBITMQ_MANAGEMENT_PORT=15672
# OMNINEST_LOG_PATH=logs/omninest.log

# --- Container memory limits ---
# BACKEND_API_MEM_LIMIT=768m
# BACKEND_WORKER_MEM_LIMIT=768m
# BACKEND_SCHEDULER_MEM_LIMIT=512m
# NGINX_MEM_LIMIT=64m
# NETEASE_MEM_LIMIT=128m
# RCLONE_MEM_LIMIT=96m
# POSTGRES_MEM_LIMIT=768m
# REDIS_MEM_LIMIT=192m
# RABBITMQ_MEM_LIMIT=320m
# MINIO_MEM_LIMIT=320m
# CLAMAV_MEM_LIMIT=1536m
# AI_SIDECAR_MEM_LIMIT=768m

# --- Per-role JVM heaps (no MaxMetaspaceSize; mem_limit bounds it) ---
# JAVA_OPTS_API=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError -XX:+UseCompactObjectHeaders
# JAVA_OPTS_WORKER=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError -XX:+UseCompactObjectHeaders
# JAVA_OPTS_SCHEDULER=-Xms64m -Xmx192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError -XX:+UseCompactObjectHeaders
# 4C4G single-instance overrides when stacking docker-compose.single.yml:
# BACKEND_API_MEM_LIMIT_SINGLE=896m
# JAVA_OPTS_API_SINGLE=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError -XX:+UseCompactObjectHeaders

# --- Database connection pool (native Spring environment binding) ---
# HIKARI_MAX_POOL=8
# HIKARI_MAX_POOL_API=10
# HIKARI_MAX_POOL_WORKER=6
# HIKARI_MAX_POOL_SCHEDULER=4
# HIKARI_MIN_IDLE=1
# HIKARI_CONNECTION_TIMEOUT=30000

# --- PostgreSQL server parameters (4C4G profile) ---
# PG_SHARED_BUFFERS=256MB
# PG_WORK_MEM=8MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_MAX_WAL_SIZE=512MB
# PG_MAX_CONNECTIONS=40

# --- Redis ---
# REDIS_MAXMEMORY=128mb

# --- Docker network (fixed subnet referenced by the OMNINEST_SECURITY_TRUSTED_PROXIES default) ---
# OMNINEST_NGINX_INTERNAL_IP=172.30.0.10
# OMNINEST_DOCKER_SUBNET=172.30.0.0/24
# OMNINEST_DOCKER_DYNAMIC_IP_RANGE=172.30.0.128/25
# Egress network (rclone and the three backend roles); must not overlap the host LAN
# OMNINEST_EGRESS_SUBNET=172.31.0.0/24
# OMNINEST_EGRESS_DYNAMIC_IP_RANGE=172.31.0.128/25

# --- certbot (adjust when enabling issuance/renewal via COMPOSE_PROFILES=certbot) ---
# CERTBOT_IDENTIFIER_TYPE=domain
# CERTBOT_CERT_NAME=omninest
# CERTBOT_EMAIL=
# CERTBOT_STAGING=false
# CERTBOT_RENEW_INTERVAL_SECONDS=43200
# CERTBOT_RETRY_INTERVAL_SECONDS=900
# CERTBOT_RELOAD_INTERVAL_SECONDS=15

# --- ClamAV scan parameters (effective with the profile enabled) ---
# CLAMD_CONF_StreamMaxLength=2047M
# CLAMD_CONF_MaxScanSize=2047M
# CLAMD_CONF_MaxFileSize=2047M
# CLAMD_CONF_MaxScanTime=1800000
# CLAMD_CONF_ReadTimeout=1800

# --- Image-analysis sidecar (effective with the profile enabled) ---
# AI_CPU_THREADS=1
# AI_VISION_PROFILE=lightweight
# ram_plus_int8 requires AI_SIDECAR_MEM_LIMIT to be at least 2560m.
# AI_SIDECAR_MEM_LIMIT=768m
# OMNINEST_PHOTO_AI_TIMEOUT_SECONDS=30
# OMNINEST_PHOTO_AI_MAX_IMAGE_BYTES=67108864
# OMNINEST_PHOTO_AI_MAX_RESPONSE_BYTES=1048576

# Worker photo AI consumer concurrency (default 2, aligned with the sidecar)
# OMNINEST_WORKER_PHOTO_AI_CONCURRENCY=2

# Media/file concurrency gates; defaults are defined in application.yml.
# OMNINEST_PHOTOS_SCAN_CONCURRENCY=3
# OMNINEST_MUSIC_SCAN_PREFETCH_CONCURRENCY=4
# OMNINEST_MUSIC_SCAN_PREFETCH_BATCH_SIZE=16
# OMNINEST_VIDEO_SCREENSHOT_CONCURRENCY=4
# OMNINEST_VIDEO_PROBE_CONCURRENCY=2
# OMNINEST_VIDEO_SUBTITLE_CONCURRENCY=2
# OMNINEST_FILE_IMPORT_MULTIPART_CONCURRENCY=4

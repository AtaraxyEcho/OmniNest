# English counterpart of .env.example; keep both templates in sync when changing either.
# Production Compose variable template. Copy to .env in this directory and replace public addresses and default credentials before deployment.
# Default profile: 4 cores / 4GB personal self-hosting with ClamAV and image analysis disabled.

# Images, versions and frontend build.
OMNINEST_BACKEND_IMAGE=omninest/backend
OMNINEST_NGINX_IMAGE=omninest/nginx
# Self-built images (including the NetEase Cloud Music API sidecar) share the OMNINEST_IMAGE_TAG version.
# OMNINEST_NETEASE_IMAGE=omninest-netease-music-api
OMNINEST_IMAGE_TAG=0.1.0
# In-site deployment prefix of the Flutter web client; only / or an absolute path such as /omninest/.
# The prefix also applies to Canvaskit, the drift worker and the endpoints (API=<prefix>api/v1, WS=<prefix>ws),
# so the reverse proxy must strip it when forwarding <prefix>api/ and <prefix>ws to the backend;
# see the sub-path deployment section in README.
OMNINEST_WEB_BASE_HREF=/

# Host ports and published mappings.
OMNINEST_SERVER_PORT=8080
OMNINEST_PUBLIC_HTTP_PORT=80
OMNINEST_PUBLIC_HTTPS_PORT=443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_MANAGEMENT_PORT=15672
ARIA2_LISTEN_PORT=6888

# Optional Compose profiles (comma separated).
# 4C4G defaults start neither virus scanning nor image analysis.
# Enable ClamAV: COMPOSE_PROFILES=clamav plus OMNINEST_CLAMAV_ENABLED=true
# Enable image analysis: COMPOSE_PROFILES=photo-ai
# COMPOSE_PROFILES=certbot,clamav,photo-ai
COMPOSE_PROFILES=

# Single 4C4G instance (optional): layer docker-compose.single.yml on top; no need to touch profiles in this file.
# OMNINEST_RUNTIME_EMBEDDED_WORKER_ENABLED is injected into the API by that override.
# BACKEND_API_MEM_LIMIT_SINGLE=896m
# JAVA_OPTS_API_SINGLE=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError

# Native variables of external containers.
POSTGRES_DB=omninest
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
REDIS_PASSWORD=
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Aria2 RPC credential; RPC_PORT stays 6800 inside the container, matching OMNINEST_ARIA2_RPC_URL on the backend side.
RPC_SECRET=omninest
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# 4C4G memory and connection pools (override with mem_limit / JAVA_OPTS / PG parameters as needed).
# Memory figures stay consistent with the docker-compose.yml defaults; adjust both places together.
# Default JVM heaps per role (uncomment and adjust to override):
# JAVA_OPTS_API=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
# JAVA_OPTS_WORKER=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
# JAVA_OPTS_SCHEDULER=-Xms64m -Xmx192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
BACKEND_API_MEM_LIMIT=768m
BACKEND_WORKER_MEM_LIMIT=768m
BACKEND_SCHEDULER_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=192m
RABBITMQ_MEM_LIMIT=320m
MINIO_MEM_LIMIT=320m
# Limits for the reverse proxy, media processing and external sidecar containers (lower than the group above).
NGINX_MEM_LIMIT=64m
FFMPEG_MEM_LIMIT=128m
NETEASE_MEM_LIMIT=128m
RCLONE_MEM_LIMIT=96m
ARIA2_MEM_LIMIT=96m
HIKARI_MAX_POOL=8
HIKARI_MAX_POOL_API=10
HIKARI_MAX_POOL_WORKER=6
HIKARI_MAX_POOL_SCHEDULER=4
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_MIN_IDLE=1
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_WAL_SIZE=512MB
PG_MAX_CONNECTIONS=40
REDIS_MAXMEMORY=128mb

# Public entry, certificates and automatic renewal.
# COMPOSE_PROFILES=certbot
OMNINEST_HTTPS_ENABLED=false
OMNINEST_PUBLIC_HOST=localhost
OMNINEST_NGINX_INTERNAL_IP=172.30.0.10
OMNINEST_DOCKER_SUBNET=172.30.0.0/24
OMNINEST_DOCKER_DYNAMIC_IP_RANGE=172.30.0.128/25
CERTBOT_IDENTIFIER_TYPE=domain
CERTBOT_CERT_NAME=omninest
CERTBOT_EMAIL=
CERTBOT_STAGING=false
CERTBOT_RENEW_INTERVAL_SECONDS=43200
CERTBOT_RETRY_INTERVAL_SECONDS=900
CERTBOT_RELOAD_INTERVAL_SECONDS=15

# Application security and first-run setup.
# HS256 JWT signing secret, at least 32 bytes; replace before deployment.
OMNINEST_SECURITY_JWT_SECRET=change-me-omninest-local-jwt-secret-at-least-32-bytes
# Base64-encoded 32-byte AES-GCM key (KEK) that encrypts external integration credentials stored in the database;
# leaving it empty counts as unconfigured, and saving credentials that require encryption then fails with a config error.
# Generate one with: openssl rand -base64 32
OMNINEST_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
# Whether self-service user registration (/api/v1/auth/register) is open. When false, accounts are created only by the super admin or administrators.
OMNINEST_SECURITY_REGISTRATION_ENABLED=false
# Trusted reverse proxies as a comma-separated IP/CIDR list. Behind Nginx, fill in the Nginx container address
# (OMNINEST_NGINX_INTERNAL_IP) or the Docker subnet, otherwise every client IP resolves to the Nginx address and login rate limiting aggregates all visitors.
OMNINEST_SECURITY_TRUSTED_PROXIES=
# Browser origins allowed for CORS and WebSocket handshakes (comma separated); change to the actual frontend address.
OMNINEST_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
# SameSite attribute of the refresh token cookie (STRICT/LAX/NONE). The default STRICT fits the Nginx same-domain reverse
# proxy layout; cross-origin deployments (frontend and API on different origin combinations) must switch to NONE, which
# forces the Secure attribute on the backend side and therefore only works over HTTPS.
OMNINEST_SECURITY_REFRESH_COOKIE_SAME_SITE=STRICT
# Whether the first-run setup wizard endpoints stay open; set to false after installation to close them off.
OMNINEST_SETUP_ENABLED=true
# Source of truth for setup completion: true reads the persisted system_instance state, false falls back to whether a SUPER_ADMIN user exists.
OMNINEST_SETUP_PERSISTENT_STATE_ENABLED=true
# Whether the setup wizard forces two-factor registration (matches the backend default of false; switch to true when needed).
OMNINEST_SETUP_TWOFACTORREQUIRED=false
# First-run setup token, at least 32 bytes. Creating the first super admin requires the same value in the X-Setup-Token request header;
# an empty or too-short value makes the setup endpoints reject every request, so it must be filled in before deployment.
OMNINEST_SETUP_TOKEN=
# Public base URL of the Flutter web frontend (the site root users open, e.g. https://media.example.com).
# It drives the setup wizard redirect and serves as the base for photo/file share links (served through
# /me/web-share-base-url); when empty, share links fall back to the client's own address and cannot be opened
# from another device, so production deployments must set it.
OMNINEST_SETUP_WEB_BASE_URL=

# Client-reachable addresses and host paths.
# MinIO address exposed to clients; it must point to Nginx port 9000.
OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Backend container log path (relative to the working directory /app); local development corresponds to backend/logs/omninest.log
OMNINEST_LOG_PATH=logs/omninest.log
# Local read-only video mounts. A controlled absolute path is recommended on production servers.
OMNINEST_LOCAL_MEDIA_ENABLED=true
OMNINEST_LOCAL_MEDIA_ROOT=../.omninest/local-media
# GeoNames offline reverse-geocoding dataset directory (in-container path backed by the omninest-geonames volume).
# To enable photo place names, drop the GeoNames dump files into that volume (e.g. docker compose cp) and restart
# the backend; the import then triggers automatically.
OMNINEST_GEO_IMPORT_DIR=/var/lib/omninest/geonames

# Conditional services and image analysis.
# 4C4G defaults keep ClamAV off; enable it for public deployments when memory allows.
OMNINEST_CLAMAV_ENABLED=false
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
OMNINEST_PHOTO_AI_TIMEOUT_SECONDS=30
OMNINEST_PHOTO_AI_MAX_IMAGE_BYTES=67108864
OMNINEST_PHOTO_AI_MAX_RESPONSE_BYTES=1048576
AI_CPU_THREADS=1
OMNINEST_MUSICBRAINZ_USER_AGENT=OmniNest/0.1.0 (contact@example.com)

# ClamAV / image analysis sidecar memory limits (effective only when the corresponding profile is enabled).
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800
CLAMAV_MEM_LIMIT=1536m
AI_SIDECAR_MEM_LIMIT=768m

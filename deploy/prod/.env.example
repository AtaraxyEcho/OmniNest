# 生产 Compose 变量模板。复制为当前目录 .env，并在部署前替换公开地址和默认凭据。

# 镜像和公开端口。
OMNINEST_BACKEND_IMAGE=omninest/backend
OMNINEST_NGINX_IMAGE=omninest/nginx
OMNINEST_IMAGE_TAG=latest
OMNINEST_SERVER_PORT=8080
OMNINEST_PUBLIC_HTTP_PORT=80
OMNINEST_PUBLIC_HTTPS_PORT=443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_MANAGEMENT_PORT=15672
ARIA2_LISTEN_PORT=6888

# 外部容器原生变量。
POSTGRES_DB=omninest
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
REDIS_PASSWORD=
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RPC_SECRET=omninest
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# 公开入口、证书和自动续期。
OMNINEST_HTTPS_ENABLED=false
OMNINEST_PUBLIC_HOST=localhost
OMNINEST_NGINX_INTERNAL_IP=172.30.0.10
OMNINEST_DOCKER_SUBNET=172.30.0.0/24
OMNINEST_DOCKER_DYNAMIC_IP_RANGE=172.30.0.128/25
CERTBOT_IDENTIFIER_TYPE=domain
CERTBOT_CERT_NAME=omninest
CERTBOT_EMAIL=
CERTBOT_STAGING=false
CERTBOT_RENEW_INTERVAL_SECONDS=43200
CERTBOT_RETRY_INTERVAL_SECONDS=900
CERTBOT_RELOAD_INTERVAL_SECONDS=15

# 应用安全和首次安装。
OMNINEST_SECURITY_JWT_SECRET=change-me-omninest-local-jwt-secret-at-least-32-bytes
OMNINEST_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
OMNINEST_SECURITY_REGISTRATION_ENABLED=false
OMNINEST_SECURITY_TRUSTED_PROXIES=
OMNINEST_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
OMNINEST_SETUP_ENABLED=true
OMNINEST_SETUP_PERSISTENT_STATE_ENABLED=true
OMNINEST_SETUP_TOKEN=
OMNINEST_SETUP_WEB_BASE_URL=
# 公网部署显式要求安装向导两步验证；代码默认 false，纯内网部署可删除此行。
OMNINEST_SETUP_TWOFACTORREQUIRED=true

# MinIO 对客户端公开的地址，必须指向 Nginx 的 9000 端口。
OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 本地影视只读挂载。生产服务器建议改为受控绝对路径。
OMNINEST_LOCAL_MEDIA_ENABLED=true
OMNINEST_LOCAL_MEDIA_ROOT=../../.omninest/local-media

# 条件服务与图片分析。
OMNINEST_CLAMAV_ENABLED=true
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
OMNINEST_PHOTO_AI_TIMEOUT_SECONDS=30
OMNINEST_PHOTO_AI_MAX_IMAGE_BYTES=67108864
OMNINEST_PHOTO_AI_MAX_RESPONSE_BYTES=1048576
AI_CPU_THREADS=2
OMNINEST_MUSICBRAINZ_USER_AGENT=OmniNest/0.1.0 (contact@example.com)

# ClamAV 容器资源边界。
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800

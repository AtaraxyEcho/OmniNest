# 英文版：.env.en.example；两份模板变量保持一致，修改时同步更新。
# 生产 Compose 变量模板。复制为当前目录 .env，并在部署前替换公开地址和默认凭据。
# 默认画像：4 核 4GB、关闭 ClamAV 与图像分析的个人自托管。

# 镜像和公开端口。
OMNINEST_BACKEND_IMAGE=omninest/backend
OMNINEST_NGINX_IMAGE=omninest/nginx
# 自建镜像（含网易云 API 侧车）统一随 OMNINEST_IMAGE_TAG 打版本。
# OMNINEST_NETEASE_IMAGE=omninest-netease-music-api
OMNINEST_IMAGE_TAG=0.1.0
OMNINEST_SERVER_PORT=8080
# 后端容器内日志路径（相对工作目录 /app）；本地开发对应 backend/logs/omninest.log
OMNINEST_LOG_PATH=logs/omninest.log
OMNINEST_PUBLIC_HTTP_PORT=80
OMNINEST_PUBLIC_HTTPS_PORT=443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_MANAGEMENT_PORT=15672
ARIA2_LISTEN_PORT=6888

# 可选 Compose profiles（逗号分隔）。
# 4C4G 默认不启动病毒扫描与图像分析。
# 启用 ClamAV：COMPOSE_PROFILES=clamav 且 OMNINEST_CLAMAV_ENABLED=true
# 启用图像分析：COMPOSE_PROFILES=photo-ai
# COMPOSE_PROFILES=certbot,clamav,photo-ai
COMPOSE_PROFILES=

# 4C4G 单实例（可选）：叠加 docker-compose.single.yml，无需改本文件 profiles。
# OMNINEST_RUNTIME_EMBEDDED_WORKER_ENABLED 由该 override 注入 API。
# BACKEND_API_MEM_LIMIT_SINGLE=896m
# JAVA_OPTS_API_SINGLE=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError

# 外部容器原生变量。
POSTGRES_DB=omninest
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
REDIS_PASSWORD=
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RPC_SECRET=omninest
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# 4C4G 内存与连接池（可用 mem_limit / JAVA_OPTS / PG 参数覆盖）。
# 内存口径与 docker-compose.yml 默认值保持一致，调整时两处同步。
# 各角色 JVM 堆默认（如需覆盖，取消注释并调整）：
# JAVA_OPTS_API=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
# JAVA_OPTS_WORKER=-Xms128m -Xmx320m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
# JAVA_OPTS_SCHEDULER=-Xms64m -Xmx192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
BACKEND_API_MEM_LIMIT=768m
BACKEND_WORKER_MEM_LIMIT=768m
BACKEND_SCHEDULER_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=192m
RABBITMQ_MEM_LIMIT=320m
MINIO_MEM_LIMIT=320m
HIKARI_MAX_POOL=8
HIKARI_MAX_POOL_API=10
HIKARI_MAX_POOL_WORKER=6
HIKARI_MAX_POOL_SCHEDULER=4
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_MIN_IDLE=1
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_WAL_SIZE=512MB
PG_MAX_CONNECTIONS=40
REDIS_MAXMEMORY=128mb

# 公开入口、证书和自动续期。
# COMPOSE_PROFILES=certbot
OMNINEST_HTTPS_ENABLED=false
OMNINEST_PUBLIC_HOST=localhost
OMNINEST_NGINX_INTERNAL_IP=172.30.0.10
OMNINEST_DOCKER_SUBNET=172.30.0.0/24
OMNINEST_DOCKER_DYNAMIC_IP_RANGE=172.30.0.128/25
CERTBOT_IDENTIFIER_TYPE=domain
CERTBOT_CERT_NAME=omninest
CERTBOT_EMAIL=
CERTBOT_STAGING=false
CERTBOT_RENEW_INTERVAL_SECONDS=43200
CERTBOT_RETRY_INTERVAL_SECONDS=900
CERTBOT_RELOAD_INTERVAL_SECONDS=15

# 应用安全和首次安装。
# HS256 JWT 签名密钥，至少 32 字节，部署前必须替换。
OMNINEST_SECURITY_JWT_SECRET=change-me-omninest-local-jwt-secret-at-least-32-bytes
# Base64 编码的 32 字节 AES-GCM 密钥（KEK），加密保存在数据库中的外部集成凭据；
# 留空表示未配置，保存需要加密的外部凭据时会直接报配置错误。可用 openssl rand -base64 32 生成。
OMNINEST_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
# 是否开放普通用户自助注册（/api/v1/auth/register）。false 时账号只能由超管或管理员创建。
OMNINEST_SECURITY_REGISTRATION_ENABLED=false
# 可信反向代理的 IP/CIDR 列表（逗号分隔）。Nginx 反代后建议填入 Nginx 容器地址
# （OMNINEST_NGINX_INTERNAL_IP）或 Docker 网段，否则客户端 IP 恒为 Nginx 地址，登录限流按全体访客聚合。
OMNINEST_SECURITY_TRUSTED_PROXIES=
# CORS 与 WebSocket 握手允许的浏览器来源（逗号分隔），改为前端实际访问地址。
OMNINEST_SECURITY_ALLOWED_ORIGINS=http://localhost:3000
# 是否开放首次安装向导接口；安装完成后建议改为 false 收口。
OMNINEST_SETUP_ENABLED=true
# 安装完成状态的判定来源：true 读取 system_instance 持久化状态，false 退化为“是否存在超管用户”。
OMNINEST_SETUP_PERSISTENT_STATE_ENABLED=true
# 安装向导是否强制注册两步验证（与后端默认一致为 false；需要时改 true）。
OMNINEST_SETUP_TWOFACTORREQUIRED=false
# 首次安装令牌，至少 32 字节。创建首个超管时必须通过 X-Setup-Token 请求头提交一致值；
# 留空或过短会导致安装接口直接拒绝，部署前必须填写。
OMNINEST_SETUP_TOKEN=
# Flutter Web 前端的基础地址。访问后端 /setup 会重定向到 {该地址}/#/setup 的安装向导；
# 留空则重定向到同源 /#/setup，适用于后端托管前端静态资源的形态。
OMNINEST_SETUP_WEB_BASE_URL=

# MinIO 对客户端公开的地址，必须指向 Nginx 的 9000 端口。
OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 本地影视只读挂载。生产服务器建议改为受控绝对路径。
OMNINEST_LOCAL_MEDIA_ENABLED=true
OMNINEST_LOCAL_MEDIA_ROOT=../../.omninest/local-media

# 条件服务与图像分析。
# 4C4G 默认关闭 ClamAV；公网且内存充足时再开启。
OMNINEST_CLAMAV_ENABLED=false
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
OMNINEST_PHOTO_AI_TIMEOUT_SECONDS=30
OMNINEST_PHOTO_AI_MAX_IMAGE_BYTES=67108864
OMNINEST_PHOTO_AI_MAX_RESPONSE_BYTES=1048576
AI_CPU_THREADS=1
OMNINEST_MUSICBRAINZ_USER_AGENT=OmniNest/0.1.0 (contact@example.com)

# ClamAV / 图像分析侧车内存边界（仅对应 profile 启用时生效）。
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800
CLAMAV_MEM_LIMIT=1536m
AI_SIDECAR_MEM_LIMIT=768m

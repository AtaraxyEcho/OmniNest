# English counterpart of .env.example; keep both templates in sync when changing either.
# Variables for development dependency containers. Copy to .env in this directory and Docker Compose picks it up automatically.

# Native variables of external containers.
POSTGRES_DB=omninest
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RPC_SECRET=omninest

# Local read-only video mounts. This value must point to the same physical media root as
# OMNINEST_LOCAL_MEDIA_ROOT in backend/.env, otherwise the backend can scan the library but the
# FFmpeg container cannot reach the source videos and audio/subtitle extraction fails (exitCode=254).
# Relative paths are resolved from deploy/dev; absolute paths also work (e.g. D:/Media on a Windows host).
OMNINEST_LOCAL_MEDIA_ROOT=../../.omninest/local-media

# ClamAV switch. By default the ClamAV container starts and virus scanning is enabled;
# when local resources are tight, comment out the next line to skip the container, but you must also set
# OMNINEST_CLAMAV_ENABLED to false in backend/.env, otherwise uploads are rejected because scanning is unavailable.
COMPOSE_PROFILES=clamav

# ClamAV container resource limits and host port.
CLAMAV_HOST_PORT=3310
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800

# Rclone RC development credentials.
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# Image analysis sidecar.
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
AI_CPU_THREADS=2

# The client-facing MinIO address does not take effect in this file: dev Compose never reads it, set it in backend/.env instead.
# Do not use localhost when an Android emulator or physical device reaches the host; write a host-reachable IP,
# the same one as OMNINEST_API_BASE_URL, for example http://192.168.1.206:9000,
# otherwise presigned URLs for backdrop videos/images cannot load on mobile clients.
# OMNINEST_MINIO_PUBLIC_ENDPOINT=http://localhost:9000

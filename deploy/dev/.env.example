# 开发依赖容器变量。复制为当前目录 .env 后由 Docker Compose 自动读取。

# 外部容器原生变量。
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RPC_SECRET=omninest

# 本地影视只读挂载。此值必须与 backend/.env 的 OMNINEST_LOCAL_MEDIA_ROOT 指向同一物理媒体根，
# 否则后端可扫描但 FFmpeg 容器内无法访问源影片，导致音频/字幕提取失败（exitCode=254）。
# 相对路径以 deploy/dev 为基准；也可使用绝对路径（如 Windows 裸机 D:/Media）。
OMNINEST_LOCAL_MEDIA_ROOT=../../.omninest/local-media

# ClamAV 开关。默认启动 ClamAV 容器并启用病毒扫描；
# 本地资源紧张时注释掉下一行即可不启动容器，但必须同步把
# backend/.env 的 OMNINEST_CLAMAV_ENABLED 改为 false，否则上传会因扫描不可用被拒绝。
COMPOSE_PROFILES=clamav

# ClamAV 容器资源边界和宿主机端口。
CLAMAV_HOST_PORT=3310
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800

# Rclone RC 开发凭据。
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# 图片分析侧车。
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
AI_CPU_THREADS=2

# MinIO 对客户端公开的地址。Android 模拟器/真机访问宿主机时不要用 localhost，
# 应写成与 OMNINEST_API_BASE_URL 同一宿主机可达 IP，例如：
# OMNINEST_MINIO_PUBLIC_ENDPOINT=http://192.168.1.206:9000
# 否则背景库视频/图片签名 URL 在移动端无法加载。
OMNINEST_MINIO_PUBLIC_ENDPOINT=${OMNINEST_MINIO_PUBLIC_ENDPOINT:-http://localhost:9000}
